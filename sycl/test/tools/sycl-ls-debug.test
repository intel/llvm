REQUIRES: linux

-- Check that '--debug' prints diagnostic information and that it is not
-- printed without it.

RUN: sycl-ls --debug > debug.out
RUN: FileCheck --input-file debug.out --check-prefix CHECK-DEBUG %s
CHECK-DEBUG-NOT: with '--debug' to get more details
CHECK-DEBUG-NOT: default_selector_v
CHECK-DEBUG-NOT: with '--debug' to get more details

-- '--debug' enables the UR loader logs on stderr.
RUN: env --unset=UR_LOG_LOADER sycl-ls --debug 2> debug_err.out
RUN: FileCheck --input-file debug_err.out --check-prefix CHECK-DEBUG-LOG %s
CHECK-DEBUG-LOG: adapters loaded

-- '--verbose' and '--debug' are independent.
RUN: sycl-ls --verbose --debug > verbose_debug.out
RUN: FileCheck --input-file verbose_debug.out --check-prefix CHECK-VERBOSE-DEBUG %s
CHECK-VERBOSE-DEBUG: Platforms:
CHECK-VERBOSE-DEBUG: default_selector_v
CHECK-VERBOSE-DEBUG-NOT: with '--debug' to get more details

RUN: sycl-ls --verbose > verbose.out
RUN: FileCheck --input-file verbose.out --check-prefix CHECK-VERBOSE %s
CHECK-VERBOSE: default_selector_v
CHECK-VERBOSE: Run with '--debug' to get more details

RUN: sycl-ls > concise.out
RUN: FileCheck --input-file concise.out --check-prefix CHECK-CONCISE %s
CHECK-CONCISE-NOT: default_selector_v

-- '--debug=all' is equivalent to '--debug'.
RUN: sycl-ls --debug=all > debug_all.out
RUN: diff debug.out debug_all.out

-- '--debug=<backends>' only enables the logs of the selected adapters. The
-- adapter loggers are unset so that only sycl-ls can enable them.
DEFINE: %{unset_loggers} = env --unset=UR_LOG_OPENCL --unset=UR_LOG_CUDA \
DEFINE:   --unset=UR_LOG_HIP --unset=UR_LOG_LEVEL_ZERO \
DEFINE:   --unset=UR_LOG_NATIVE_CPU --unset=UR_LOG_OFFLOAD
RUN: %{unset_loggers} sycl-ls --debug=cuda 2> debug_cuda_err.out
RUN: FileCheck --input-file debug_cuda_err.out --check-prefix CHECK-DEBUG-CUDA %s
CHECK-DEBUG-CUDA-NOT: <OPENCL>[
CHECK-DEBUG-CUDA-NOT: <HIP>[
CHECK-DEBUG-CUDA-NOT: <LEVEL_ZERO>[
CHECK-DEBUG-CUDA-NOT: <NATIVE_CPU>[
CHECK-DEBUG-CUDA-NOT: <OFFLOAD>[

RUN: %{unset_loggers} sycl-ls --debug=hip,cuda 2> debug_hip_cuda_err.out
RUN: FileCheck --input-file debug_hip_cuda_err.out --check-prefix CHECK-DEBUG-HIP-CUDA %s
CHECK-DEBUG-HIP-CUDA-NOT: <OPENCL>[
CHECK-DEBUG-HIP-CUDA-NOT: <LEVEL_ZERO>[
CHECK-DEBUG-HIP-CUDA-NOT: <NATIVE_CPU>[
CHECK-DEBUG-HIP-CUDA-NOT: <OFFLOAD>[

-- The UR loader logs are enabled regardless of the selected backends.
RUN: env --unset=UR_LOG_LOADER %{unset_loggers} sycl-ls --debug=native_cpu 2> debug_native_cpu_err.out
RUN: FileCheck --input-file debug_native_cpu_err.out --check-prefixes CHECK-DEBUG-LOG,CHECK-DEBUG-NATIVE-CPU %s
CHECK-DEBUG-NATIVE-CPU-NOT: <OPENCL>[
CHECK-DEBUG-NATIVE-CPU-NOT: <CUDA>[
CHECK-DEBUG-NATIVE-CPU-NOT: <HIP>[
CHECK-DEBUG-NATIVE-CPU-NOT: <LEVEL_ZERO>[
CHECK-DEBUG-NATIVE-CPU-NOT: <OFFLOAD>[

-- Unknown backends are rejected.
RUN: not sycl-ls --debug=foo > debug_foo.out 2>&1
RUN: FileCheck --input-file debug_foo.out --check-prefix CHECK-DEBUG-FOO %s
CHECK-DEBUG-FOO: ERROR: Unknown backend 'foo' passed to --debug.
CHECK-DEBUG-FOO: Usage: sycl-ls [--verbose] [--debug[=<backends>]] [--ignore-device-selectors]
