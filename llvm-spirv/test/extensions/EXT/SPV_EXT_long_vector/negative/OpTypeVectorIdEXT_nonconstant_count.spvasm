; OpTypeVectorIdEXT: Component Count must be a constant instruction. Here the
; count is an OpUndef, which the reverse translator must reject rather than
; attempt to evaluate as a constant.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: InvalidInstruction
; CHECK: TypeVectorIdEXT: component count must be a constant instruction

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %fn "test"
               OpDecorate %fn LinkageAttributes "test" Export
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
    %uint_ud = OpUndef %uint
      %float = OpTypeFloat 32
        %vec = OpTypeVectorIdEXT %float %uint_ud
    %fn_type = OpTypeFunction %void %vec
         %fn = OpFunction %void None %fn_type
        %arg = OpFunctionParameter %vec
      %entry = OpLabel
               OpReturn
               OpFunctionEnd
