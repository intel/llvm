; Checks an edge case when the component count is an OpSpecConstantOp with
; udiv by 0. This is illegal arithmetic and LLVM can't fold it into a ConstantInt,
; in this case the Reader must check and reject.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: InvalidInstruction
; CHECK: TypeVectorIdEXT: component count must evaluate to a constant integer

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %fn "test"
               OpDecorate %fn LinkageAttributes "test" Export
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
      %float = OpTypeFloat 32
     %uint_0 = OpConstant %uint 0
   %count_op = OpSpecConstantOp %uint UDiv %uint_0 %uint_0
        %vec = OpTypeVectorIdEXT %float %count_op
    %fn_type = OpTypeFunction %void %vec
         %fn = OpFunction %void None %fn_type
        %arg = OpFunctionParameter %vec
      %entry = OpLabel
               OpReturn
               OpFunctionEnd
